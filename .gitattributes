# Normalização consistente entre Linux, Windows e macOS
* text=auto
*.java text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.pdf binary
*.png binary

# O Maven Wrapper precisa continuar executável no Linux
mvnw text eol=lf
mvnw linguist-generated=false
